{
  "name": "senderscope-mcp",
  "version": "1.0.0",
  "description": "MCP connector for Senderscope: reverse email lookup, work-email finder and email verification for B2B.",
  "type": "module",
  "bin": {
    "senderscope-mcp": "server/index.js"
  },
  "files": [
    "server",
    "icon.png",
    "manifest.json",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.mjs",
    "bundle": "mcpb pack . senderscope.mcpb"
  },
  "dependencies": {
    "mcp-remote": "0.14.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Senderscope",
  "license": "MIT",
  "homepage": "https://senderscope.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senderscope/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/senderscope/mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "senderscope",
    "reverse-email-lookup",
    "email-finder",
    "email-verification",
    "b2b-data"
  ],
  "mcpName": "io.github.senderscope/mcp-server",
  "overrides": {
    "tmp": "^0.2.6"
  }
}
